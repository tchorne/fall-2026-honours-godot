size = Vector2(460, 220)
expression = "vec4 start_end_mask(vec4 current, vec2 uv, float end_uv){
	float mask = clamp((uv.x-0.1)*20.0, 0, 1);
	mask *= clamp((end_uv-uv.x-0.05)*20.0, 0, 1);
	current.a *= mask;
	return current;
}
"

